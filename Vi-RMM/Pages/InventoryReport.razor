@page "/reporting/inventory"
@inject AgentService AgentSvc

<PageTitle>Hardware & Software Inventory - Vi-RMM</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <div class="eyebrow">Reporting</div>
            <h1>Hardware & Asset Inventory Report</h1>
            <p>Exportable fleet hardware specifications, CPU, RAM, and disk capacities.</p>
        </div>
        <button class="primary-button" onclick="window.print()">🖨 Print / Export</button>
    </div>

    <div class="user-table">
        <div class="user-head" style="grid-template-columns: 1.5fr 1.5fr 2fr 1fr 1fr 1fr;">
            <span>Hostname</span>
            <span>Client / Site</span>
            <span>Processor</span>
            <span>RAM</span>
            <span>Storage</span>
            <span>IP Address</span>
        </div>

        @foreach (var agent in AgentSvc.GetAllAgents())
        {
            <div class="user-row" style="grid-template-columns: 1.5fr 1.5fr 2fr 1fr 1fr 1fr;">
                <span><strong>@agent.Hostname</strong></span>
                <span>@agent.Client (@agent.Site)</span>
                <span>@(string.IsNullOrEmpty(agent.Registration.ProcessorName) ? "Not reported" : agent.Registration.ProcessorName)</span>
                <span>@(agent.Registration.TotalMemoryBytes > 0 ? $"{agent.Registration.TotalMemoryBytes / (1024 * 1024 * 1024)} GB" : "Not reported")</span>
                <span>@(agent.Registration.TotalDiskBytes > 0 ? $"{agent.Registration.TotalDiskBytes / (1024 * 1024 * 1024)} GB" : "Not reported")</span>
                <span><code>@(string.IsNullOrEmpty(agent.Registration.LocalIp) ? "Not reported" : agent.Registration.LocalIp)</code></span>
            </div>
        }
        @if (!AgentSvc.GetAllAgents().Any())
        {
            <div class="user-row"><span class="muted">No endpoint data received.</span></div>
        }
    </div>
</div>

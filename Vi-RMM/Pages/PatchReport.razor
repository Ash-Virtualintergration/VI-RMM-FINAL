@page "/reporting/patches"
@inject AgentService AgentSvc

<PageTitle>Patch Compliance - Vi-RMM</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <div class="eyebrow">Reporting</div>
            <h1>Windows Patch Compliance Report</h1>
            <p>Summary of Windows security hotfixes and quality rollups deployed across all endpoints.</p>
        </div>
        <button class="primary-button" onclick="window.print()">🖨 Print Report</button>
    </div>

    <div class="user-table">
        <div class="user-head" style="grid-template-columns: 2fr 1.5fr 1.5fr 1.5fr 1fr;">
            <span>Endpoint</span>
            <span>Client / Site</span>
            <span>OS Build</span>
            <span>Latest HotFix</span>
            <span>Compliance</span>
        </div>

        @foreach (var agent in AgentSvc.GetAllAgents())
        {
            @foreach (var patch in agent.Patches)
            {
                <div class="user-row" style="grid-template-columns: 2fr 1.5fr 1.5fr 1.5fr 1fr;">
                    <span><strong>@agent.Hostname</strong></span>
                    <span>@agent.Client (@agent.Site)</span>
                    <span>@agent.OperatingSystem</span>
                    <span><code>@patch.KbArticleId</code></span>
                    <span>@patch.Status</span>
                </div>
            }
        }
        @if (!AgentSvc.GetAllAgents().Any(agent => agent.Patches.Count > 0))
        {
            <div class="user-row"><span class="muted">No patch data received.</span></div>
        }
    </div>
</div>

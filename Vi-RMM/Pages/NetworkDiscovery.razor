@page "/tools/discovery"
@inject AgentService AgentSvc

<PageTitle>Network Discovery - Vi-RMM</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <div class="eyebrow">Tools & Diagnostics</div>
            <h1>Network Discovery Scanner</h1>
            <p>Discover unmanaged network devices from a connected endpoint.</p>
        </div>
        <span class="muted">Discovery is unavailable until a scan provider is configured.</span>
    </div>
    <div class="user-table">
        <div class="user-head" style="grid-template-columns: 1.5fr 1.5fr 1.5fr 1fr 1fr;">
            <span>IP Address</span>
            <span>MAC Address</span>
            <span>Device / Hostname</span>
            <span>Type</span>
            <span>Agent Status</span>
        </div>

        <div class="user-row"><span class="muted">No discovery results are available.</span></div>
    </div>
</div>

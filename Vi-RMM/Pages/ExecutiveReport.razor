@page "/reporting/summary"
@inject AgentService AgentSvc

<PageTitle>Executive Report - Vi-RMM</PageTitle>

@{
    var agents = AgentSvc.GetAllAgents();
    var checks = agents.SelectMany(agent => agent.Checks).ToArray();
    var drives = agents.SelectMany(agent => agent.Registration.Drives).ToArray();
    var onlineCount = agents.Count(agent => agent.Status == "Online");
    var onlineSummary = agents.Count == 0 ? "—" : $"{onlineCount} / {agents.Count}";
    var complianceSummary = checks.Length == 0
        ? "—"
        : $"{checks.Count(check => check.IsPassing) * 100.0 / checks.Length:F1}%";
    var totalStorage = drives.Sum(drive => drive.TotalBytes);
    var storageSummary = totalStorage == 0
        ? "—"
        : $"{drives.Sum(drive => drive.FreeBytes) * 100.0 / totalStorage:F1}%";
}

<div class="page-container">
    <div class="page-header">
        <div>
            <div class="eyebrow">Reporting</div>
            <h1>Executive Endpoint Health Summary</h1>
            <p>Infrastructure availability, disk capacity, and endpoint security posture.</p>
        </div>
        <button class="primary-button" onclick="window.print()">🖨 Export PDF / Print</button>
    </div>

    <div class="agents-summary-cards">
        <div class="summary-card">
            <h3>Endpoints Currently Online</h3>
            <div class="big-number online-text">@onlineSummary</div>
            <span class="muted">Based on current agent connections</span>
        </div>
        <div class="summary-card">
            <h3>Security Compliance</h3>
            <div class="big-number">@complianceSummary</div>
            <span class="muted">@(checks.Length == 0 ? "No health-check data received" : $"{checks.Length} reported checks")</span>
        </div>
        <div class="summary-card">
            <h3>Storage Health</h3>
            <div class="big-number">@storageSummary</div>
            <span class="muted">@(drives.Length == 0 ? "No drive data received" : "Free capacity across reported drives")</span>
        </div>
    </div>

    <div class="summary-grid" style="margin-top:20px;">
        <div class="summary-card">
            <h3>Client Organization Breakdown</h3>
            <ul style="padding-left:20px;line-height:2;font-size:13px;">
                @foreach (var c in agents.GroupBy(a => string.IsNullOrWhiteSpace(a.Client) ? "Unassigned" : a.Client))
                {
                    <li><strong>@c.Key</strong>: @c.Count() endpoints (@c.Count(a => a.Status == "Online") online)</li>
                }
                @if (agents.Count == 0)
                {
                    <li>No endpoint data received.</li>
                }
            </ul>
        </div>

        <div class="summary-card">
            <h3>Operating System Fleet Distribution</h3>
            <ul style="padding-left:20px;line-height:2;font-size:13px;">
                <li>Windows 11: @agents.Count(a => a.OperatingSystem.Contains("11", StringComparison.OrdinalIgnoreCase))</li>
                <li>Windows 10: @agents.Count(a => a.OperatingSystem.Contains("10", StringComparison.OrdinalIgnoreCase))</li>
                <li>Windows Server: @agents.Count(a => a.OperatingSystem.Contains("Server", StringComparison.OrdinalIgnoreCase))</li>
            </ul>
        </div>
    </div>
</div>

@inherits LayoutComponentBase
@inject UserStore Users
@inject SessionState Session
@inject NavigationManager Navigation

<div class="app-shell @(darkMode ? "theme-dark" : "theme-light")">
    <header class="topbar">
        <div class="brand">
            <div class="brand-mark">V</div>
            <div>
                <div class="brand-name">Vi-RMM</div>
                <div class="brand-subtitle">Remote Monitoring & Management</div>
            </div>
        </div>

        <nav class="top-menu">
            <a href="/">File</a>
            <a href="/">View</a>
            <div class="menu">
                <button class="menu-button">Agents ▾</button>
                <div class="menu-panel">
                    <a href="/agents">All Agents</a>
                    <a href="/agents/install">Install Agent</a>
                    <a href="/">Agent Policies</a>
                    <a href="/">Agent Groups</a>
                </div>
            </div>
            <div class="menu">
                <button class="menu-button">Settings ▾</button>
                <div class="menu-panel">
                    <a href="/users">Users & Roles</a>
                    <a href="/">Security</a>
                    <a href="/">Notifications</a>
                </div>
            </div>
            <a href="/">Tools</a>
            <a href="/">Reporting</a>
            <a href="/">Help</a>
        </nav>

        <div class="profile-wrap">
            <button class="profile-button" @onclick="ToggleProfile">
                @if (!string.IsNullOrWhiteSpace(Session.CurrentUser?.ProfileImage))
                {
                    <img src="@Session.CurrentUser.ProfileImage" alt="Profile" class="avatar" />
                }
                else
                {
                    <span class="avatar initials">@GetInitials()</span>
                }
                <span>@(Session.CurrentUser?.FullName ?? "Administrator")</span>
                <span class="chevron">▾</span>
            </button>

            @if (profileOpen)
            {
                <div class="profile-menu">
                    <div class="profile-heading">
                        <strong>@(Session.CurrentUser?.FullName ?? "Administrator")</strong>
                        <span>@(Session.CurrentUser?.Role ?? "Administrator")</span>
                    </div>
                    <a href="/users" @onclick="CloseProfile">👥 Manage Users</a>
                    <button @onclick="ToggleTheme">@((darkMode ? "☀" : "🌙")) @(darkMode ? "Light Mode" : "Dark Theme")</button>

                    <label class="profile-upload">
                        🖼 Change Profile Picture
                        <InputFile OnChange="ChangeProfilePicture" accept="image/png,image/jpeg,image/webp" />
                    </label>

                    <div class="profile-divider"></div>
                    <button class="danger-button" @onclick="SignOut">↪ Sign Out</button>
                </div>
            }
        </div>
    </header>

    <main class="main-area">
        @Body
    </main>
</div>

@code {
    private bool profileOpen;
    private bool darkMode;

    protected override void OnInitialized()
    {
        darkMode = true;
    }

    private void ToggleProfile() => profileOpen = !profileOpen;

    private void CloseProfile() => profileOpen = false;

    private void ToggleTheme()
    {
        darkMode = !darkMode;
        profileOpen = false;
    }

    private string GetInitials()
    {
        var name = Session.CurrentUser?.FullName ?? "Administrator";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant()
            : $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private async Task ChangeProfilePicture(InputFileChangeEventArgs e)
    {
        if (Session.CurrentUser is null || e.File is null)
            return;

        await using var stream = e.File.OpenReadStream(2 * 1024 * 1024);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);

        var mime = e.File.ContentType;
        Session.CurrentUser.ProfileImage =
            $"data:{mime};base64,{Convert.ToBase64String(memory.ToArray())}";

        Users.Save(Session.CurrentUser);
        profileOpen = false;
    }

    private void SignOut()
    {
        Session.SignOut();
        profileOpen = false;
        Navigation.NavigateTo("/login");
    }
}
